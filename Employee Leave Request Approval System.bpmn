    <bpmn:serviceTask id="Activity_10svlx3" name="Check Leave Balance">
      <bpmn:incoming>Flow_0tt20wv</bpmn:incoming>
      <bpmn:outgoing>Flow_10wzxwr</bpmn:outgoing>
    </bpmn:serviceTask>
