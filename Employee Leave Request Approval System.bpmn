      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decision = "INSUFFICIENT_BALANCE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_1mi8bi5" name="Auto Approve Leave">
