        <zeebe:calledDecision decisionId="Definitions_1w8mnpt" resultVariable="decision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_10wzxwr</bpmn:incoming>
      <bpmn:outgoing>Flow_1fzpkgs</bpmn:outgoing>
