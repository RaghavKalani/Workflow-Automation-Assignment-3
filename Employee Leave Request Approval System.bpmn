  <bpmn:process id="Process_0ur0xmw" name="MANAGER_REVIEW" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Employee Submits Leave Request">
      <bpmn:outgoing>Flow_0uhxt9f</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_0m1bgy4" name="Validate Leave Request">
